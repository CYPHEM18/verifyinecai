# Copy to .env.local for local runs; add the same three in Vercel > Settings > Environment Variables.
# Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=llama-3.1-8b-instant

# Own model later (Ollama behind a Cloudflare Tunnel):
# LLM_BASE_URL=https://your-tunnel.trycloudflare.com/v1
# LLM_API_KEY=your-tunnel-secret
# LLM_MODEL=qwen2.5:7b

# Live web search (free key from langsearch.com > Dashboard > API keys). Optional: without it, only data/corpus.json is used.
LANGSEARCH_API_KEY=your-langsearch-key
